{
  "name": "markbreak-app",
  "version": "0.1.0-dev",
  "description": "MarkBreak writer for print manuscripts",
  "private": true,
  "homepage": "https://markbreak.app",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=10"
  },
  "scripts": {
    "postinstall": "tsx scripts/postinstall.ts",
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "minify-locales": "tsx scripts/minify-locales.ts",
    "rebuild-native": "pnpm --filter markbreak rebuild-native",
    "start": "pnpm --filter markbreak start",
    "dev": "pnpm --filter markbreak dev",
    "build": "pnpm --filter markbreak build",
    "build:unpack": "pnpm --filter markbreak build:unpack",
    "build:win": "pnpm --filter markbreak build:win",
    "build:win:x64": "pnpm --filter markbreak build:win:x64",
    "build:win:arm64": "pnpm --filter markbreak build:win:arm64",
    "build:mac": "pnpm --filter markbreak build:mac",
    "build:mac:x64": "pnpm --filter markbreak build:mac:x64",
    "build:mac:arm64": "pnpm --filter markbreak build:mac:arm64",
    "build:linux": "pnpm --filter markbreak build:linux",
    "build:linux:x64": "pnpm --filter markbreak build:linux:x64",
    "build:linux:arm64": "pnpm --filter markbreak build:linux:arm64",
    "perf:inspect": "pnpm --filter markbreak perf:inspect",
    "perf:inspect-brk": "pnpm --filter markbreak perf:inspect-brk",
    "test": "pnpm --filter markbreak test",
    "test:unit": "pnpm --filter markbreak test:unit",
    "test:e2e": "pnpm --filter markbreak test:e2e",
    "typecheck": "pnpm --filter markbreak typecheck",
    "typecheck:watch": "pnpm --filter markbreak typecheck:watch",
    "check": "pnpm lint && pnpm typecheck",
    "gen-third-party": "tsx scripts/generateThirdPartyLicense.ts",
    "validate-licenses": "tsx scripts/validateLicenses.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "packages/desktop/src/**/*.{ts,vue}": [
      "eslint --fix"
    ],
    "packages/desktop/test/**/*.ts": [
      "eslint --fix"
    ],
    "*.{json,md,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@babel/eslint-parser": "^8.0.7",
    "@eslint/js": "^10.0.1",
    "electron": "~45.0.0",
    "eslint": "^10.13.0",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-i18n-json": "^4.0.1",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-vue": "^10.12.0",
    "husky": "^9.1.7",
    "license-checker": "^25.0.1",
    "lint-staged": "^17.6.0",
    "neostandard": "^0.14.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vue-eslint-parser": "^10.4.1"
  }
}
